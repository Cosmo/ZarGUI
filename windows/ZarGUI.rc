#pragma code_page(65001)

#include <windows.h>
#include "src/resource.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "ZarGUI"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "ZarGUI"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "ZarGUI.exe"
            VALUE "ProductName", "ZarGUI"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Create archive from folder…\tCtrl+N", IDM_CREATE
        MENUITEM "&Open archive…\tCtrl+O", IDM_OPEN
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Settings…", IDM_SETTINGS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ZarGUI", IDM_ABOUT
    END
END

IDR_ARCHIVE_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open archive…\tCtrl+O", IDM_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Extract &all…", IDM_EXTRACT_ALL
        MENUITEM "&Extract selected…", IDM_EXTRACT_SELECTED
        MENUITEM SEPARATOR
        MENUITEM "&Close", IDM_CLOSE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Up one level\tAlt+Up", IDM_UP
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ZarGUI", IDM_ABOUT
    END
END

IDD_MAIN DIALOGEX 0, 0, 270, 128
STYLE DS_SHELLFONT | DS_CENTER | WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "ZarGUI"
MENU IDR_MAIN_MENU
FONT 9, "MS Shell Dlg", 400, 0, 1
BEGIN
    ICON            "", IDC_ICON, 7, 7, 21, 20
    LTEXT           "Drag folders or .zar archives onto this window. Folders are packed into a .zar archive; archives are opened so you can browse and extract them.", IDC_INSTRUCTION, 36, 7, 227, 26
    GROUPBOX        "Save new archives", -1, 7, 38, 256, 48
    AUTORADIOBUTTON "&Next to the original folder", IDC_NEXT_TO, 14, 51, 200, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&In this folder:", IDC_IN_FOLDER, 14, 67, 62, 10
    EDITTEXT        IDC_FOLDER, 78, 65, 132, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "&Browse…", IDC_BROWSE, 213, 65, 44, 14
    PUSHBUTTON      "&Open archive…", IDM_OPEN, 125, 94, 66, 14
    PUSHBUTTON      "&Create archive…", IDM_CREATE, 197, 94, 66, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 280, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "MS Shell Dlg", 400, 0, 1
BEGIN
    GROUPBOX        "Creating archives", -1, 7, 7, 266, 64
    LTEXT           "If the archive already &exists:", -1, 14, 22, 110, 8
    COMBOBOX        IDC_EXISTING, 140, 20, 126, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Compression:", -1, 14, 39, 110, 8
    COMBOBOX        IDC_COMPRESSION, 140, 37, 126, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&Skip system files (Thumbs.db, desktop.ini, .DS_Store, ._ files)", IDC_SKIP_SYSTEM, 14, 55, 252, 10
    GROUPBOX        "Extracting", -1, 7, 76, 266, 46
    LTEXT           "Extract &to:", -1, 14, 91, 110, 8
    COMBOBOX        IDC_DESTINATION, 140, 89, 126, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Show extracted items in &File Explorer", IDC_REVEAL, 14, 107, 252, 10
    DEFPUSHBUTTON   "OK", IDOK, 169, 129, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 129, 50, 14
END
