<Window
    x:Class="ZarGUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Content>
        <ScrollViewer>
            <StackPanel x:Name="Root" Padding="24,16,24,24" Spacing="4" MaxWidth="720">
                <StackPanel.Resources>
                    <Style x:Key="Card" TargetType="Grid">
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="ColumnSpacing" Value="16" />
                        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    </Style>
                    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                        <Setter Property="Margin" Value="0,16,0,4" />
                    </Style>
                    <Style x:Key="Description" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </StackPanel.Resources>

                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="Archiving" Style="{StaticResource SectionHeader}" />

                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Save archives in" />
                        <TextBlock x:Name="OutputText" Style="{StaticResource Description}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ResetOutputButton" Content="Reset" Click="OnResetOutput" />
                        <Button Content="Choose…" Click="OnChooseOutput" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="If an archive already exists" VerticalAlignment="Center" />
                    <ComboBox x:Name="ExistingCombo" Grid.Column="1" MinWidth="180"
                              AutomationProperties.Name="If an archive already exists"
                              SelectionChanged="OnChanged">
                        <x:String>Ask</x:String>
                        <x:String>Replace it</x:String>
                        <x:String>Keep both</x:String>
                    </ComboBox>
                </Grid>

                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Compression" />
                        <TextBlock Style="{StaticResource Description}"
                                   Text="Smaller archives take longer to create. Every setting can be read by any .zar reader." />
                    </StackPanel>
                    <ComboBox x:Name="CompressionCombo" Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                              AutomationProperties.Name="Compression" SelectionChanged="OnChanged">
                        <x:String>Faster</x:String>
                        <x:String>Standard</x:String>
                        <x:String>Smaller</x:String>
                    </ComboBox>
                </Grid>

                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Skip system files" />
                        <TextBlock Style="{StaticResource Description}" Text="Thumbs.db, desktop.ini, .DS_Store, ._ files and similar" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SkipSystemToggle" Grid.Column="1" OnContent="On" OffContent="Off"
                                  AutomationProperties.Name="Skip system files" Toggled="OnChanged" />
                </Grid>

                <TextBlock Text="Extracting" Style="{StaticResource SectionHeader}" />

                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Extract to" VerticalAlignment="Center" />
                    <ComboBox x:Name="DestinationCombo" Grid.Column="1" MinWidth="180"
                              AutomationProperties.Name="Extract to" SelectionChanged="OnChanged">
                        <x:String>Ask each time</x:String>
                        <x:String>The folder containing the archive</x:String>
                    </ComboBox>
                </Grid>

                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show extracted items in File Explorer" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="RevealToggle" Grid.Column="1" OnContent="On" OffContent="Off"
                                  AutomationProperties.Name="Show extracted items in File Explorer" Toggled="OnChanged" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Window.Content>
</Window>
