<Window
    x:Class="ZarGUI.ArchiveWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZarGUI">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
            <AppBarButton x:Name="ExtractSelectedButton" Label="Extract selected" Icon="Download"
                          IsEnabled="False" Click="OnExtractSelected"
                          ToolTipService.ToolTip="Extract the selected items" />
            <AppBarButton x:Name="ExtractAllButton" Label="Extract all" IsEnabled="False"
                          Click="OnExtractAll" ToolTipService.ToolTip="Extract everything into a new folder">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8F4;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- Contents -->
        <Grid Grid.Row="1" Padding="12,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,6,40,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="Size" TextAlignment="Right"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <TreeView x:Name="Tree" Grid.Row="1" SelectionMode="Multiple"
                      CanDragItems="True" CanReorderItems="False" AllowDrop="False"
                      DragItemsStarting="OnDragItemsStarting"
                      AutomationProperties.Name="Archive contents"
                      SelectionChanged="OnSelectionChanged">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="local:ArchiveNode">
                        <TreeViewItem ItemsSource="{x:Bind Children}"
                                      AutomationProperties.Name="{x:Bind Name}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <ProgressRing x:Name="LoadingRing" Grid.RowSpan="2" IsActive="True"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel x:Name="ErrorPanel" Grid.RowSpan="2" Spacing="8" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <FontIcon Glyph="&#xE7BA;" FontSize="36"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Can’t open archive" TextAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="ErrorText" TextAlignment="Center" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Footer: status, or progress while extracting -->
        <Grid Grid.Row="2" Padding="16,8" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="ProgressPanel" Spacing="4" Visibility="Collapsed">
                <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" IsIndeterminate="True"
                             AutomationProperties.Name="Extraction progress" />
                <TextBlock x:Name="ProgressFile" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Visibility="Collapsed"
                    Click="OnCancel" />
        </Grid>
    </Grid>
</Window>
