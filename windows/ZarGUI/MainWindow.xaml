<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZarGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ZarGUI">

    <!-- The whole window accepts drops; the card shows where and what will happen. -->
    <Grid x:Name="Root" AllowDrop="True"
          DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenArchiveAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCreateArchiveAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar: back button (settings only), then the draggable caption area. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource NavigationBackButtonNormalStyle}"
                    Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                    Click="OnBack" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back" />
            <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TitleText" Text="ZarGUI" Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Home -->
        <Grid x:Name="HomeView" Grid.Row="1" Padding="24,4,24,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="DropCard" CornerRadius="8" MinHeight="220"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Rectangle x:Name="DropOutline" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                           Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Rectangle x:Name="DropOutlineActive" RadiusX="8" RadiusY="8" StrokeThickness="2" Visibility="Collapsed"
                           Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                           Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />

                <!-- Waiting for a drop -->
                <StackPanel x:Name="IdlePanel" Spacing="8" Padding="24" MaxWidth="420"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="40" Margin="0,0,0,8"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Drag a folder or a .zar archive here" TextAlignment="Center" TextWrapping="Wrap"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Folders are packed into a .zar archive. Archives open so you can browse and extract them."
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="OnCreateArchive">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                <TextBlock Text="Choose folder" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnOpenArchive">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                <TextBlock Text="Open archive" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- While something is dragged over the window -->
                <StackPanel x:Name="DropHintPanel" Spacing="12" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon x:Name="DropHintIcon" Glyph="&#xE896;" FontSize="48"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="DropHintText" Text="Drop to create an archive" TextAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>

                <!-- Creating an archive -->
                <StackPanel x:Name="BusyPanel" Spacing="8" Padding="32,24" Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="BusyTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Minimum="0" Maximum="1"
                                 AutomationProperties.Name="Archive progress" />
                    <TextBlock x:Name="BusyFile" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="QueueText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Content="Cancel" HorizontalAlignment="Right" Click="OnCancel">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ResultBar" Grid.Row="1" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="ShowInFolderButton" Content="Show in folder" Click="OnShowInFolder" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="SaveLocationText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnOpenSettings" ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings" Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>
        </Grid>

        <!-- Settings, in the style of the Windows 11 Settings app -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed">
            <StackPanel Padding="24,0,24,24" Spacing="4" MaxWidth="1000">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                <TextBlock Text="Creating archives" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74E;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Save location" />
                        <TextBlock x:Name="SettingsLocationText" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ResetLocationButton" Content="Reset" Click="OnResetLocation" />
                        <Button Content="Browse" Click="OnBrowseLocation" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C8;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="If the archive already exists" />
                        <TextBlock Text="What to do when a .zar file with the same name is already there"
                                   Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ExistingCombo" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                              SelectionChanged="OnSettingChanged" AutomationProperties.Name="If the archive already exists">
                        <x:String>Ask me</x:String>
                        <x:String>Replace it</x:String>
                        <x:String>Keep both</x:String>
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7B8;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Compression" />
                        <TextBlock Text="Smaller archives take longer to create. Every setting can be read by any .zar reader."
                                   Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="CompressionCombo" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                              SelectionChanged="OnSettingChanged" AutomationProperties.Name="Compression">
                        <x:String>Faster</x:String>
                        <x:String>Standard</x:String>
                        <x:String>Smaller</x:String>
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE71C;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Skip system files" />
                        <TextBlock Text="Thumbs.db, desktop.ini, .DS_Store, ._ files and similar"
                                   Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SkipSystemToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                                  Toggled="OnSettingToggled" AutomationProperties.Name="Skip system files" />
                </Grid>

                <TextBlock Text="Extracting" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Extract to" />
                        <TextBlock Text="Where extracted files go" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="DestinationCombo" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                              SelectionChanged="OnSettingChanged" AutomationProperties.Name="Extract to">
                        <x:String>Ask every time</x:String>
                        <x:String>Next to the archive</x:String>
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A7;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Open File Explorer when done" />
                        <TextBlock Text="Show the extracted files in File Explorer" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RevealToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                                  Toggled="OnSettingToggled" AutomationProperties.Name="Open File Explorer when done" />
                </Grid>

                <TextBlock Text="About" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ZarGUI 0.3.0" />
                        <TextBlock Text="Creates, browses and extracts ZArchive (.zar) files. MIT License. Uses ZArchive and Zstandard."
                                   Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
